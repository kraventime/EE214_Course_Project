transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vcom -93 -work work {C:/ee214_project/Task2/keypad_interface.vhd}
vcom -93 -work work {C:/ee214_project/Task2/keygen.vhd}

vcom -93 -work work {C:/ee214_project/Task2/keypad_tb.vhd}

vsim -t 1ps -L altera -L lpm -L sgate -L altera_mf -L altera_lnsim -L fiftyfivenm -L rtl_work -L work -voptargs="+acc"  keypad_interface

add wave *
view structure
view signals
run -all
